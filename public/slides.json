  {
    "kind": "code",
    "chapter": "04 / Sessions",
    "title": "Keep a conversation going",
    "signature": "createSession(options?) → session.stream(prompt)",
    "file": "chat.ts",
    "points": [
      [
        "Open a session",
        [
          "createSession"
        ],
        "A session keeps context across prompts. Close it when you finish."
      ],
      [
        "Send follow-ups",
        [
          "const prompts",
          "for (const prompt"
        ],
        "The second prompt says “it”. Droid knows it means the bug from the first turn."
      ],
      [
        "Stream the work",
        [
          "session.stream(prompt)",
          "DroidMessageType.Assistant"
        ],
        "Events arrive as the agent works. Show them live in your UI."
      ]
    ],
    "excerpt": "import { createSession, DroidMessageType } from \"@factory/droid-sdk/node\";\nconst session = await createSession({ cwd: \".\" });\nconst prompts = [\"Find the bug in src/app.ts.\", \"Fix it and run the tests.\"];\nfor (const prompt of prompts) {\n  for await (const message of session.stream(prompt)) {\n    if (message.type === DroidMessageType.Assistant) console.log(message.text);\n  }\n}\nawait session.close();",
    "lineNumbers": [
      1,
      3,
      4,
      6,
      7,
      8,
      9,
      10,
      12
    ],
