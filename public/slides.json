  {
    "kind": "code",
    "chapter": "02 / run()",
    "title": "One prompt, one answer",
    "signature": "run(prompt, options?) → Promise<DroidResult>",
    "file": "run.ts",
    "points": [
      [
        "Send a prompt",
        [
          "const prompt",
          "run(prompt"
        ],
        "Droid reads the files in cwd, uses its tools and finishes the task."
      ],
      [
        "Read the answer",
        [
          "result.text"
        ],
        "The final text of the agent. run() closes its session for you."
      ]
    ],
    "excerpt": "import { run } from \"@factory/droid-sdk/node\";\nconst prompt = \"Explain what this repository does in one sentence.\";\nconst cwd = \".\";\nconst result = await run(prompt, { cwd });\nconsole.log(result.text);",
    "lineNumbers": [
      1,
      3,
      4,
      5,
      7
    ],
    "highlightedLines": [
      "<span class=\"syntax-token\" style=\"color:#F97583\">import</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> { run } </span><span class=\"syntax-token\" style=\"color:#F97583\">from</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#9ECBFF\">&quot;@factory/droid-sdk/node&quot;</span><span class=\"syntax-token\" style=\"color:#D2CCC7\">;</span>",
      "<span class=\"syntax-token\" style=\"color:#F97583\">const</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#79B8FF\">prompt</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#F97583\">=</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#9ECBFF\">&quot;Explain what this repository does in one sentence.&quot;</span><span class=\"syntax-token\" style=\"color:#D2CCC7\">;</span>",
      "<span class=\"syntax-token\" style=\"color:#F97583\">const</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#79B8FF\">cwd</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#F97583\">=</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#9ECBFF\">&quot;.&quot;</span><span class=\"syntax-token\" style=\"color:#D2CCC7\">;</span>",
      "<span class=\"syntax-token\" style=\"color:#F97583\">const</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#79B8FF\">result</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#F97583\">=</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#F97583\">await</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#B392F0\">run</span><span class=\"syntax-token\" style=\"color:#D2CCC7\">(prompt, { cwd });</span>",
