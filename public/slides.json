      "<span class=\"syntax-token\" style=\"color:#F97583\">const</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#79B8FF\">Triage</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> </span><span class=\"syntax-token\" style=\"color:#F97583\">=</span><span class=\"syntax-token\" style=\"color:#D2CCC7\"> z.</span><span class=\"syntax-token\" style=\"color:#B392F0\">strictObject</span><span class=\"syntax-token\" style=\"color:#D2CCC7\">({</span>",
