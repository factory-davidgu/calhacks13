  {
    "kind": "code",
    "chapter": "03 / Structured output",
    "title": "Get JSON your code can use",
    "signature": "run(prompt, { outputFormat: { type, schema } })",
    "file": "structured-output.ts",
    "points": [
      [
        "Describe the shape",
        [
          "z.strictObject",
          "z.enum"
        ],
        "A Zod schema with fixed labels: the agent must pick from these lists."
      ],
      [
        "Pass it to run()",
        [
          "outputFormat:",
          "OutputFormatType.JsonSchema"
        ],
        "Send the schema as JSON Schema with the prompt."
      ],
      [
        "Branch on typed data",
        [
          "Triage.parse",
          "ticket.severity"
        ],
        "Parse structuredOutput and use it like any other object."
      ]
    ],
    "excerpt": "import { OutputFormatType, run } from \"@factory/droid-sdk/node\";\nimport { z } from \"zod/v4\";\nconst Triage = z.strictObject({\n  category: z.enum([\"bug\", \"feature\", \"question\"]),\n  severity: z.enum([\"low\", \"medium\", \"high\"]),\n  area: z.string(),\n});\nconst issue = \"The app crashes when I upload a PNG larger than 10 MB.\";\nconst prompt = `Classify this issue for triage: ${issue}`;\nconst result = await run(prompt, {\n  outputFormat: {\n    type: OutputFormatType.JsonSchema,\n    schema: z.toJSONSchema(Triage, { target: \"draft-7\" }),\n  },\n});\nconst ticket = Triage.parse(result.structuredOutput);\nif (ticket.severity === \"high\") console.log(\"Page on-call for\", ticket.area);",
    "lineNumbers": [
